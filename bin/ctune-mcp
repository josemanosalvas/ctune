#!/bin/sh
# Start the ctune MCP server on the Python of its virtual environment, which `bin/ctune mcp-setup` creates.
repo=$(dirname "$(dirname "$(realpath "$0")")")
python="$repo/tools/mcp-venv/bin/python"
if [ ! -x "$python" ]; then
    echo "ctune: the MCP server has no virtual environment yet. Run $repo/bin/ctune mcp-setup once." >&2
    exit 1
fi
exec "$python" -I "$repo/ctune/mcp_server.py"
